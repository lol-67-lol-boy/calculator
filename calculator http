<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Scientific Calculator</title>
  <style>
    :root {
      color-scheme: dark;
      --bg: #0c1020;
      --panel: #151a2e;
      --button: #222941;
      --button-hover: #303955;
      --accent: #8b7cff;
      --text: #f5f6ff;
      --muted: #9ba4c0;
      --danger: #ed6a82;
    }

    * { box-sizing: border-box; }

    body {
      min-height: 100vh;
      margin: 0;
      padding: 32px 16px;
      display: grid;
      place-items: center;
      background:
        radial-gradient(ellipse at top left, #24234d 0, transparent 42%),
        var(--bg);
      color: var(--text);
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .calculator {
      width: min(100%, 440px);
      padding: 22px;
      border: 1px solid #ffffff14;
      border-radius: 24px;
      background: color-mix(in srgb, var(--panel) 94%, transparent);
      box-shadow: 0 24px 80px #0007;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 18px;
    }

    h1 {
      margin: 0;
      font-size: 1.05rem;
      letter-spacing: .02em;
    }

    .mode {
      padding: 7px 12px;
      border: 1px solid #ffffff20;
      border-radius: 999px;
      background: transparent;
      color: var(--accent);
      cursor: pointer;
      font-weight: 700;
    }

    .display {
      min-height: 118px;
      padding: 18px;
      margin-bottom: 16px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      gap: 8px;
      overflow: hidden;
      border: 1px solid #ffffff0d;
      border-radius: 16px;
      background: #0b0f1d;
      text-align: right;
    }

    .expression {
      min-height: 1.5em;
      overflow-x: auto;
      color: var(--muted);
      font-size: 1rem;
      white-space: nowrap;
    }

    .result {
      overflow-x: auto;
      font-size: clamp(2rem, 9vw, 2.8rem);
      font-weight: 650;
      line-height: 1.15;
      white-space: nowrap;
    }

    .error { color: var(--danger); }

    .keys {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 9px;
    }

    .key {
      min-height: 54px;
      border: 1px solid #ffffff0a;
      border-radius: 13px;
      background: var(--button);
      color: var(--text);
      cursor: pointer;
      font: inherit;
      font-size: 1rem;
      transition: background .15s, transform .08s;
    }

    .key:hover { background: var(--button-hover); }
    .key:active { transform: scale(.96); }
    .key.function { color: #c8c0ff; }
    .key.utility { color: var(--muted); }
    .key.clear { color: var(--danger); }
    .key.operator { color: #d3ccff; }
    .key.equals {
      grid-column: span 2;
      background: var(--accent);
      color: white;
      font-size: 1.2rem;
      font-weight: 750;
    }
    .key.equals:hover { background: #7667ed; }

    .history {
      margin-top: 20px;
      border-top: 1px solid #ffffff14;
      padding-top: 14px;
    }

    .history-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
      color: var(--muted);
      font-size: .85rem;
    }

    .history-header button {
      border: 0;
      background: transparent;
      color: var(--accent);
      cursor: pointer;
    }

    .history-list {
      display: grid;
      gap: 6px;
      max-height: 130px;
      overflow-y: auto;
    }

    .history-item {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      padding: 7px 9px;
      border: 0;
      border-radius: 8px;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      text-align: left;
    }

    .history-item:hover { background: #ffffff0a; }
    .history-item strong { color: var(--text); }

    @media (max-width: 380px) {
      .calculator { padding: 15px; }
      .keys { gap: 7px; }
      .key { min-height: 48px; font-size: .9rem; }
    }
  </style>
</head>
<body>
  <main class="calculator" aria-label="Scientific calculator">
    <div class="topbar">
      <h1>Scientific Calculator</h1>
      <button class="mode" id="angleMode" type="button" aria-label="Toggle angle mode">DEG</button>
    </div>

    <section class="display" aria-live="polite">
      <div class="expression" id="expression"></div>
      <div class="result" id="result">0</div>
    </section>

    <section class="keys" id="keys" aria-label="Calculator keys">
      <button class="key utility" data-action="memory-clear">MC</button>
      <button class="key utility" data-action="memory-recall">MR</button>
      <button class="key utility" data-action="memory-add">M+</button>
      <button class="key utility" data-value="(">(</button>
      <button class="key utility" data-value=")">)</button>

      <button class="key function" data-value="sin(">sin</button>
      <button class="key function" data-value="cos(">cos</button>
      <button class="key function" data-value="tan(">tan</button>
      <button class="key function" data-value="sqrt(">√</button>
      <button class="key clear" data-action="clear">AC</button>

      <button class="key function" data-value="asin(">sin⁻¹</button>
      <button class="key function" data-value="acos(">cos⁻¹</button>
      <button class="key function" data-value="atan(">tan⁻¹</button>
      <button class="key function" data-value="^2">x²</button>
      <button class="key utility" data-action="backspace">⌫</button>

      <button class="key function" data-value="log(">log</button>
      <button class="key function" data-value="ln(">ln</button>
      <button class="key function" data-value="abs(">abs</button>
      <button class="key function" data-value="!">x!</button>
      <button class="key operator" data-value="/">÷</button>

      <button class="key" data-value="7">7</button>
      <button class="key" data-value="8">8</button>
      <button class="key" data-value="9">9</button>
      <button class="key function" data-value="^">xʸ</button>
      <button class="key operator" data-value="*">×</button>

      <button class="key" data-value="4">4</button>
      <button class="key" data-value="5">5</button>
      <button class="key" data-value="6">6</button>
      <button class="key function" data-value="%">%</button>
      <button class="key operator" data-value="-">−</button>

      <button class="key" data-value="1">1</button>
      <button class="key" data-value="2">2</button>
      <button class="key" data-value="3">3</button>
      <button class="key function" data-value="pi">π</button>
      <button class="key operator" data-value="+">+</button>

      <button class="key" data-value="0">0</button>
      <button class="key" data-value=".">.</button>
      <button class="key function" data-value="e">e</button>
      <button class="key utility" data-value="ans">Ans</button>
      <button class="key equals" data-action="equals">=</button>
    </section>

    <section class="history">
      <div class="history-header">
        <span>History</span>
        <button id="clearHistory" type="button">Clear</button>
      </div>
      <div class="history-list" id="historyList"></div>
    </section>
  </main>

  <script>
    const expressionEl = document.getElementById("expression");
    const resultEl = document.getElementById("result");
    const keysEl = document.getElementById("keys");
    const angleModeEl = document.getElementById("angleMode");
    const historyListEl = document.getElementById("historyList");

    let expression = "";
    let angleMode = "DEG";
    let memory = 0;
    let lastAnswer = 0;
    let justEvaluated = false;
    const history = [];

    function formatNumber(value) {
      if (!Number.isFinite(value)) throw new Error("Result is not finite");
      if (Object.is(value, -0)) value = 0;
      return Number(value.toPrecision(12)).toString();
    }

    function tokenize(source) {
      const tokens = [];
      let i = 0;

      while (i < source.length) {
        const rest = source.slice(i);
        if (/^\s/.test(rest)) {
          i++;
          continue;
        }

        const number = rest.match(/^(?:\d+(?:\.\d*)?|\.\d+)(?:e[+-]?\d+)?/i);
        if (number) {
          tokens.push({ type: "number", value: Number(number[0]) });
          i += number[0].length;
          continue;
        }

        const identifier = rest.match(/^[a-z]+/i);
        if (identifier) {
          tokens.push({ type: "identifier", value: identifier[0].toLowerCase() });
          i += identifier[0].length;
          continue;
        }

        if ("+-*/^%!,()".includes(source[i])) {
          tokens.push({ type: source[i], value: source[i] });
          i++;
          continue;
        }

        throw new Error(`Unexpected character: ${source[i]}`);
      }

      return tokens;
    }

    function calculate(source) {
      const tokens = tokenize(source);
      let position = 0;

      const peek = () => tokens[position];
      const take = () => tokens[position++];

      function expect(type) {
        const token = take();
        if (!token || token.type !== type) {
          throw new Error(`Expected "${type}"`);
        }
        return token;
      }

      function expressionRule() {
        let value = termRule();
        while (peek()?.type === "+" || peek()?.type === "-") {
          const operator = take().type;
          const right = termRule();
          value = operator === "+" ? value + right : value - right;
        }
        return value;
      }

      function termRule() {
        let value = unaryRule();
        while (peek()?.type === "*" || peek()?.type === "/") {
          const operator = take().type;
          const right = unaryRule();
          value = operator === "*" ? value * right : value / right;
        }
        return value;
      }

      function unaryRule() {
        if (peek()?.type === "+") {
          take();
          return unaryRule();
        }
        if (peek()?.type === "-") {
          take();
          return -unaryRule();
        }
        return powerRule();
      }

      function powerRule() {
        let value = postfixRule();
        if (peek()?.type === "^") {
          take();
          value = Math.pow(value, unaryRule());
        }
        return value;
      }

      function postfixRule() {
        let value = primaryRule();
        while (peek()?.type === "!" || peek()?.type === "%") {
          const operator = take().type;
          if (operator === "!") {
            if (value < 0 || !Number.isInteger(value) || value > 170) {
              throw new Error("Factorial requires an integer from 0 to 170");
            }
            let product = 1;
            for (let n = 2; n <= value; n++) product *= n;
            value = product;
          } else {
            value /= 100;
          }
        }
        return value;
      }

      function primaryRule() {
        const token = take();
        if (!token) throw new Error("Incomplete expression");

        if (token.type === "number") return token.value;

        if (token.type === "(") {
          const value = expressionRule();
          expect(")");
          return value;
        }

        if (token.type === "identifier") {
          const name = token.value;

          if (peek()?.type === "(") {
            take();
            const argument = expressionRule();
            expect(")");
            return applyFunction(name, argument);
          }

          if (name === "pi") return Math.PI;
          if (name === "e") return Math.E;
          if (name === "ans") return lastAnswer;
          throw new Error(`Unknown value: ${name}`);
        }

        throw new Error("Invalid expression");
      }

      const value = expressionRule();
      if (position < tokens.length) throw new Error("Unexpected input");
      return value;
    }

    function applyFunction(name, value) {
      const toRadians = angleMode === "DEG" ? Math.PI / 180 : 1;
      const fromRadians = angleMode === "DEG" ? 180 / Math.PI : 1;

      const functions = {
        sin: x => Math.sin(x * toRadians),
        cos: x => Math.cos(x * toRadians),
        tan: x => Math.tan(x * toRadians),
        asin: x => Math.asin(x) * fromRadians,
        acos: x => Math.acos(x) * fromRadians,
        atan: x => Math.atan(x) * fromRadians,
        sqrt: x => Math.sqrt(x),
        abs: x => Math.abs(x),
        ln: x => Math.log(x),
        log: x => Math.log10(x)
      };

      if (!functions[name]) throw new Error(`Unknown function: ${name}`);
      return functions[name](value);
    }

    function updateDisplay() {
      expressionEl.textContent = expression || "";
      if (!expression) {
        resultEl.textContent = "0";
        resultEl.classList.remove("error");
        return;
      }

      try {
        resultEl.textContent = formatNumber(calculate(expression));
        resultEl.classList.remove("error");
      } catch {
        resultEl.textContent = "…";
        resultEl.classList.remove("error");
      }
    }

    function append(value) {
      const startsNew = /^[0-9.]$/.test(value) || value === "pi" || value === "e";
      if (justEvaluated && startsNew) expression = "";
      justEvaluated = false;

      if (value === "ans") {
        expression += "ans";
      } else {
        expression += value;
      }

      updateDisplay();
    }

    function evaluate() {
      if (!expression) return;

      try {
        const answer = calculate(expression);
        const formatted = formatNumber(answer);
        history.unshift({ expression, result: formatted });
        history.splice(8);
        lastAnswer = answer;
        resultEl.textContent = formatted;
        resultEl.classList.remove("error");
        renderHistory();
        justEvaluated = true;
      } catch (error) {
        resultEl.textContent = error.message;
        resultEl.classList.add("error");
      }
    }

    function renderHistory() {
      historyListEl.replaceChildren();
      for (const item of history) {
        const button = document.createElement("button");
        button.className = "history-item";
        button.type = "button";

        const source = document.createElement("span");
        source.textContent = item.expression;

        const value = document.createElement("strong");
        value.textContent = item.result;

        button.append(source, value);
        button.addEventListener("click", () => {
          expression = item.expression;
          justEvaluated = false;
          updateDisplay();
        });
        historyListEl.append(button);
      }
    }

    keysEl.addEventListener("click", event => {
      const button = event.target.closest("button");
      if (!button) return;

      const { action, value } = button.dataset;

      if (action === "clear") {
        expression = "";
        justEvaluated = false;
        updateDisplay();
      } else if (action === "backspace") {
        expression = expression.slice(0, -1);
        justEvaluated = false;
        updateDisplay();
      } else if (action === "equals") {
        evaluate();
      } else if (action === "memory-clear") {
        memory = 0;
      } else if (action === "memory-recall") {
        append(formatNumber(memory));
      } else if (action === "memory-add") {
        try {
          memory += expression ? calculate(expression) : Number(resultEl.textContent) || 0;
        } catch {
          // Ignore invalid expressions.
        }
      } else if (value) {
        append(value);
      }
    });

    angleModeEl.addEventListener("click", () => {
      angleMode = angleMode === "DEG" ? "RAD" : "DEG";
      angleModeEl.textContent = angleMode;
      updateDisplay();
    });

    document.getElementById("clearHistory").addEventListener("click", () => {
      history.length = 0;
      renderHistory();
    });

    document.addEventListener("keydown", event => {
      if (/^[0-9.]$/.test(event.key)) append(event.key);
      else if ("+-*/^()%!".includes(event.key)) append(event.key);
      else if (event.key === "Enter" || event.key === "=") {
        event.preventDefault();
        evaluate();
      } else if (event.key === "Backspace") {
        expression = expression.slice(0, -1);
        justEvaluated = false;
        updateDisplay();
      } else if (event.key === "Escape") {
        expression = "";
        justEvaluated = false;
        updateDisplay();
      }
    });
  </script>
</body>
</html>
